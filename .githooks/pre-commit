#!/bin/sh
# Pre-commit hook for worktime-pomodoro

echo "🔍 Running pre-commit checks..."

# Check if we're in the right directory
if [ ! -f "package.json" ]; then
    echo "❌ Not in project root"
    exit 1
fi

# 1. Auto-format, then re-stage the files that were already staged
echo "📝 Formatting code..."
staged=$(git diff --cached --name-only --diff-filter=ACMR)
cargo fmt --manifest-path=src-tauri/Cargo.toml --all || exit 1
npm run fmt >/dev/null || exit 1
if [ -n "$staged" ]; then
    echo "$staged" | xargs git add --
fi
echo "✅ Formatting applied"

# 2. Rust clippy
echo "🔍 Running Clippy..."
if ! cargo clippy --manifest-path=src-tauri/Cargo.toml --all-targets -- -D warnings; then
    echo "❌ Clippy check failed"
    exit 1
fi
echo "✅ Clippy OK"

# 3. Rust tests
echo "🧪 Running Rust tests..."
if ! cargo test --manifest-path=src-tauri/Cargo.toml --lib; then
    echo "❌ Tests failed"
    exit 1
fi
echo "✅ Tests OK"

# 4. Frontend linting with oxlint
echo "🎨 Running oxlint..."
if ! npm run lint; then
    echo "❌ Linting failed"
    exit 1
fi
echo "✅ Linting OK"

echo "✅ All pre-commit checks passed!"
exit 0
