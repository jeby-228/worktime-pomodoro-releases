{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "worktime-pomodoro",
  "mainBinaryName": "worktime-pomodoro",
  "version": "1.0.1",
  "identifier": "com.worktime.pomodoro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "番茄工時",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true
      },
      {
        "label": "minibar",
        "title": "Mini Bar",
        "url": "minibar.html",
        "width": 240,
        "height": 48,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "pet",
        "title": "Desktop Pet",
        "url": "pet.html",
        "width": 192,
        "height": 208,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "language": "zh-TW"
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "templates/worktime-pomodoro.desktop"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MjVERjhCODIyNkE5MkQKUldRdHFTYUNpOThsV0FoRkovM2dsRHg4MVU3UWs5bmJlTEtLK3Yyam9IcWVxV3NNRlU5NnJYY2oK",
      "endpoints": [
        "https://github.com/jeby-228/worktime-pomodoro-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
