{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "worktime-pomodoro",
  "mainBinaryName": "worktime-pomodoro",
  "version": "1.2.3",
  "identifier": "com.worktime.pomodoro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "番茄工時",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "language": "zh-TW"
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "templates/worktime-pomodoro.desktop"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MjVERjhCODIyNkE5MkQKUldRdHFTYUNpOThsV0FoRkovM2dsRHg4MVU3UWs5bmJlTEtLK3Yyam9IcWVxV3NNRlU5NnJYY2oK",
      "endpoints": [
        "https://github.com/jeby-228/worktime-pomodoro-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
