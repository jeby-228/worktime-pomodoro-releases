---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesktopLayout from '$components/DesktopLayout.svelte';
import TodayTimeline from '$components/TodayTimeline.svelte';
---

<BaseLayout title="今日 - 工時記錄">
  <DesktopLayout currentRoute="today" client:load>
    <div class="h-screen p-6">
      <TodayTimeline client:load />
    </div>
  </DesktopLayout>
</BaseLayout>
