---
import DesktopLayout from '$components/DesktopLayout.svelte';
import { List, Table, Filter, Download, Calendar } from 'lucide-svelte';
import '$styles/global.css';
---

<DesktopLayout currentRoute="records">
  <div class="flex h-screen">
    <!-- Main Content -->
    <div class="flex-1 flex flex-col">
      <!-- Toolbar -->
      <div class="flex items-center justify-between border-b border-border px-6 py-4">
        <div class="flex items-center gap-3">
          <!-- View toggle -->
          <div class="flex rounded-md border border-border">
            <button class="flex items-center gap-2 rounded-l-md bg-accent px-3 py-2 text-sm font-medium text-accent-foreground">
              <List class="size-4" />
              列表
            </button>
            <button class="flex items-center gap-2 rounded-r-md px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-accent/50">
              <Table class="size-4" />
              表格
            </button>
          </div>
          
          <!-- Date range -->
          <button class="flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-accent">
            <Calendar class="size-4" />
            10/19 - 10/23
          </button>
          
          <!-- Filter -->
          <button class="flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-accent">
            <Filter class="size-4" />
            類型
          </button>
          
          <!-- Search -->
          <input 
            type="search" 
            placeholder="搜尋任務、單號..." 
            class="w-64 rounded-md border border-border bg-background px-3 py-2 text-sm placeholder:text-muted-foreground"
          />
        </div>
        
        <!-- Export -->
        <button class="flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
          <Download class="size-4" />
          匯出 xlsx
        </button>
      </div>
      
      <!-- Records List -->
      <div class="flex-1 overflow-y-auto">
        <div class="divide-y divide-border">
          <!-- Day group header -->
          <div class="bg-muted/30 px-6 py-2 text-sm font-medium">
            <div class="flex items-center justify-between">
              <span>日 10/23 週五</span>
              <div class="flex items-center gap-4 text-muted-foreground">
                <span>已記錄 5h 25m / 8h</span>
                <span>7 筆</span>
              </div>
            </div>
          </div>
          
          <!-- Slot items (same Item style as TodayTimeline) -->
          <button class="flex w-full items-center gap-3 px-6 py-3 text-left hover:bg-accent/50">
            <div class="flex size-10 flex-shrink-0 items-center justify-center rounded-md bg-muted">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <div class="font-medium truncate">ECU 韌體 #4521</div>
                <span class="flex-shrink-0 text-xs text-muted-foreground">#4521</span>
              </div>
              <div class="mt-1 text-sm text-muted-foreground">
                09:00-09:50 · 50 分
              </div>
            </div>
          </button>
          
          <!-- Interrupt (nested with pl-12) -->
          <button class="flex w-full items-center gap-3 px-6 py-3 pl-12 text-left hover:bg-accent/50">
            <div class="flex size-10 flex-shrink-0 items-center justify-center rounded-md bg-muted">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <div class="font-medium truncate">產線問題</div>
                <span class="flex-shrink-0 rounded bg-accent px-2 py-0.5 text-xs font-medium text-accent-foreground">
                  插隊
                </span>
              </div>
              <div class="mt-1 text-sm text-muted-foreground">
                09:50-10:05 · 15 分
              </div>
            </div>
          </button>
          
          <!-- Gap (dashed border) -->
          <div class="flex items-center gap-3 border-dashed px-6 py-3">
            <div class="flex size-10 flex-shrink-0 items-center justify-center rounded-md border-2 border-dashed border-warning/50">
              <svg class="size-5 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-warning">
                未記錄 35 分
              </div>
              <div class="mt-1 text-sm text-muted-foreground">
                10:55-11:30
              </div>
            </div>
            <button class="flex-shrink-0 rounded px-3 py-1.5 text-sm font-medium text-warning hover:bg-warning/10">
              補記
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Summary Side Panel -->
    <div class="w-80 border-l border-border bg-card">
      <div class="p-6">
        <h3 class="mb-4 text-sm font-semibold">依任務彙總</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium">ECU 韌體 #4521</div>
              <div class="h-2 mt-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-primary" style="width: 70%"></div>
              </div>
            </div>
            <div class="ml-4 flex-shrink-0 text-sm font-semibold tabular-nums">9h 10m</div>
          </div>
          
          <div class="flex items-center justify-between">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium">測試治具 #4533</div>
              <div class="h-2 mt-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-primary" style="width: 33%"></div>
              </div>
            </div>
            <div class="ml-4 flex-shrink-0 text-sm font-semibold tabular-nums">4h 20m</div>
          </div>
          
          <div class="flex items-center justify-between">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium">會議</div>
              <div class="h-2 mt-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-primary" style="width: 15%"></div>
              </div>
            </div>
            <div class="ml-4 flex-shrink-0 text-sm font-semibold tabular-nums">2h 00m</div>
          </div>
          
          <div class="flex items-center justify-between">
            <div class="min-w-0 flex-1">
              <div class="truncate font-medium">插隊</div>
              <div class="h-2 mt-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-accent" style="width: 8%"></div>
              </div>
            </div>
            <div class="ml-4 flex-shrink-0 text-sm font-semibold tabular-nums">1h 05m</div>
          </div>
        </div>
        
        <div class="mt-6 pt-6 border-t border-border">
          <div class="flex items-center justify-between text-sm">
            <span class="text-muted-foreground">共 38 筆 · 本週</span>
            <span class="font-medium">21h 15m</span>
          </div>
          <div class="mt-2 flex items-center justify-between text-sm text-muted-foreground">
            <span>總計 21h 15m</span>
            <span>未記錄 1h 40m</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</DesktopLayout>
