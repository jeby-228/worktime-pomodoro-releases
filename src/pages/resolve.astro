---
// 待確認區間處理頁面
const pageTitle = "處理待確認時段";
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: "Microsoft JhengHei", "PingFang TC", sans-serif;
            background: #f7fafc;
            padding: 24px;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        
        .header {
            margin-bottom: 24px;
        }
        
        .header h1 {
            font-size: 28px;
            color: #2d3748;
            margin-bottom: 8px;
        }
        
        .header-subtitle {
            color: #718096;
            font-size: 14px;
        }
        
        .alert {
            background: #fff5f5;
            border-left: 4px solid #fc8181;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
        }
        
        .alert-title {
            font-weight: 600;
            color: #742a2a;
            margin-bottom: 4px;
        }
        
        .alert-text {
            color: #c53030;
            font-size: 14px;
        }
        
        .unknown-item {
            background: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 16px;
        }
        
        .unknown-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 2px solid #e2e8f0;
        }
        
        .time-range {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 600;
            color: #2d3748;
        }
        
        .duration {
            display: inline-block;
            padding: 6px 16px;
            background: #fff5f5;
            border: 2px solid #fc8181;
            border-radius: 20px;
            color: #c53030;
            font-size: 14px;
            font-weight: 600;
        }
        
        .reason {
            background: #f7fafc;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 16px;
        }
        
        .reason-label {
            font-size: 12px;
            color: #a0aec0;
            margin-bottom: 4px;
        }
        
        .reason-text {
            color: #4a5568;
            font-size: 14px;
        }
        
        .options-label {
            font-size: 14px;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 12px;
        }
        
        .task-options {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }
        
        .task-option {
            padding: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
        }
        
        .task-option:hover {
            border-color: #667eea;
            background: #f7fafc;
        }
        
        .task-option.selected {
            border-color: #667eea;
            background: #edf2f7;
        }
        
        .task-option-name {
            font-size: 14px;
            color: #2d3748;
            font-weight: 500;
        }
        
        .task-option-meta {
            font-size: 12px;
            color: #a0aec0;
            margin-top: 4px;
        }
        
        .custom-task {
            margin-top: 12px;
        }
        
        .custom-task input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
        }
        
        .custom-task input:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .actions {
            display: flex;
            gap: 12px;
        }
        
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            flex: 1;
        }
        
        .btn-primary {
            background: #667eea;
            color: white;
        }
        
        .btn-primary:hover {
            background: #5a67d8;
        }
        
        .btn-secondary {
            background: #edf2f7;
            color: #4a5568;
        }
        
        .btn-secondary:hover {
            background: #e2e8f0;
        }
        
        .btn-danger {
            background: #fff5f5;
            color: #c53030;
            border: 2px solid #fc8181;
        }
        
        .btn-danger:hover {
            background: #fed7d7;
        }
        
        .empty-state {
            background: white;
            border-radius: 12px;
            padding: 48px 24px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        
        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 16px;
        }
        
        .empty-state-title {
            font-size: 20px;
            color: #2d3748;
            font-weight: 600;
            margin-bottom: 8px;
        }
        
        .empty-state-text {
            color: #a0aec0;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚠️ 處理待確認時段</h1>
            <div class="header-subtitle">指定以下時段您在做什麼工作</div>
        </div>
        
        <div class="alert">
            <div class="alert-title">⏰ 發現 2 個待確認時段</div>
            <div class="alert-text">請確認這些時段的工作內容，以確保工時記錄完整準確</div>
        </div>
        
        <div class="unknown-item">
            <div class="unknown-header">
                <div class="time-range">
                    <span>10:40</span>
                    <span style="color: #a0aec0;">→</span>
                    <span>11:05</span>
                </div>
                <div class="duration">25 分鐘</div>
            </div>
            
            <div class="reason">
                <div class="reason-label">原因</div>
                <div class="reason-text">🔴 番茄鐘跳窗逾時未回應</div>
            </div>
            
            <div class="options-label">這段時間您在做：</div>
            
            <div class="task-options">
                <div class="task-option selected" data-option="task1">
                    <div class="task-option-name">📌 繼續前一個任務</div>
                    <div class="task-option-meta">計劃A | 開發功能</div>
                </div>
                
                <div class="task-option" data-option="meeting">
                    <div class="task-option-name">📅 參加會議</div>
                    <div class="task-option-meta">臨時會議</div>
                </div>
                
                <div class="task-option" data-option="problem">
                    <div class="task-option-name">🔧 處理 User 問題</div>
                    <div class="task-option-meta">緊急問題處理</div>
                </div>
                
                <div class="task-option" data-option="break">
                    <div class="task-option-name">☕ 休息</div>
                    <div class="task-option-meta">短暫休息</div>
                </div>
                
                <div class="task-option" data-option="ignore">
                    <div class="task-option-name">🚫 忽略</div>
                    <div class="task-option-meta">不記錄此時段</div>
                </div>
                
                <div class="task-option" data-option="custom">
                    <div class="task-option-name">✏️ 自訂任務</div>
                    <div class="task-option-meta">輸入其他任務</div>
                </div>
            </div>
            
            <div class="custom-task" style="display: none;">
                <input type="text" placeholder="輸入任務名稱..." id="custom-task-1">
            </div>
            
            <div class="actions">
                <button class="btn btn-primary">✓ 確認並套用</button>
                <button class="btn btn-secondary">→ 稍後處理</button>
            </div>
        </div>
        
        <div class="unknown-item">
            <div class="unknown-header">
                <div class="time-range">
                    <span>15:20</span>
                    <span style="color: #a0aec0;">→</span>
                    <span>16:00</span>
                </div>
                <div class="duration">40 分鐘</div>
            </div>
            
            <div class="reason">
                <div class="reason-label">原因</div>
                <div class="reason-text">💤 電腦進入睡眠狀態</div>
            </div>
            
            <div class="options-label">這段時間您在做：</div>
            
            <div class="task-options">
                <div class="task-option selected" data-option="task2">
                    <div class="task-option-name">📌 繼續前一個任務</div>
                    <div class="task-option-meta">計劃B | 撰寫文檔</div>
                </div>
                
                <div class="task-option" data-option="meeting2">
                    <div class="task-option-name">📅 參加會議</div>
                    <div class="task-option-meta">臨時會議</div>
                </div>
                
                <div class="task-option" data-option="break2">
                    <div class="task-option-name">☕ 休息</div>
                    <div class="task-option-meta">午休或休息</div>
                </div>
                
                <div class="task-option" data-option="ignore2">
                    <div class="task-option-name">🚫 忽略</div>
                    <div class="task-option-meta">不記錄此時段</div>
                </div>
            </div>
            
            <div class="actions">
                <button class="btn btn-primary">✓ 確認並套用</button>
                <button class="btn btn-secondary">→ 稍後處理</button>
            </div>
        </div>
    </div>
    
    <script>
        // Task option selection
        document.querySelectorAll('.task-option').forEach(option => {
            option.addEventListener('click', () => {
                const parent = option.closest('.unknown-item');
                parent.querySelectorAll('.task-option').forEach(o => o.classList.remove('selected'));
                option.classList.add('selected');
                
                // Show custom task input if custom option selected
                const customInput = parent.querySelector('.custom-task');
                if (option.dataset.option === 'custom') {
                    customInput.style.display = 'block';
                } else {
                    customInput.style.display = 'none';
                }
            });
        });
        
        // Confirm buttons
        document.querySelectorAll('.btn-primary').forEach(btn => {
            btn.addEventListener('click', () => {
                const item = btn.closest('.unknown-item');
                console.log('Resolve unknown period:', item);
                // In real app: invoke('resolve_unknown', { ... })
                
                item.style.opacity = '0.5';
                btn.textContent = '✓ 已處理';
                btn.disabled = true;
                
                setTimeout(() => {
                    item.remove();
                    
                    // Check if all resolved
                    if (document.querySelectorAll('.unknown-item').length === 0) {
                        showEmptyState();
                    }
                }, 500);
            });
        });
        
        // Skip buttons
        document.querySelectorAll('.btn-secondary').forEach(btn => {
            btn.addEventListener('click', () => {
                console.log('Skip for now');
                alert('稍後處理 - 此時段仍標記為待確認');
            });
        });
        
        function showEmptyState() {
            const container = document.querySelector('.container');
            container.innerHTML = `
                <div class="empty-state">
                    <div class="empty-state-icon">✅</div>
                    <div class="empty-state-title">太好了！</div>
                    <div class="empty-state-text">目前沒有待確認的時段</div>
                </div>
            `;
        }
    </script>
</body>
</html>
