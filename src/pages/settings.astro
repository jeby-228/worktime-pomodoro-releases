---
// 設定頁面
const pageTitle = "設定";
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: "Microsoft JhengHei", "PingFang TC", sans-serif;
            background: #f7fafc;
            padding: 24px;
        }
        
        .container {
            max-width: 700px;
            margin: 0 auto;
        }
        
        .header {
            margin-bottom: 24px;
        }
        
        .header h1 {
            font-size: 28px;
            color: #2d3748;
            margin-bottom: 8px;
        }
        
        .header-subtitle {
            color: #718096;
            font-size: 14px;
        }
        
        .section {
            background: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 16px;
        }
        
        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 2px solid #e2e8f0;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group:last-child {
            margin-bottom: 0;
        }
        
        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
        }
        
        .form-help {
            font-size: 12px;
            color: #a0aec0;
            margin-top: 4px;
        }
        
        .form-input {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.2s;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .form-select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            background: white;
            cursor: pointer;
        }
        
        .form-check {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .form-checkbox {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
        
        .time-range {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 12px;
            align-items: center;
        }
        
        .actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .btn-primary {
            background: #667eea;
            color: white;
            flex: 1;
        }
        
        .btn-primary:hover {
            background: #5a67d8;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }
        
        .btn-secondary {
            background: #edf2f7;
            color: #4a5568;
        }
        
        .btn-secondary:hover {
            background: #e2e8f0;
        }
        
        .badge {
            display: inline-block;
            padding: 4px 12px;
            background: #edf2f7;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            color: #4a5568;
        }
        
        .badge.success {
            background: #c6f6d5;
            color: #22543d;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚙️ 設定</h1>
            <div class="header-subtitle">自訂您的工時記錄偏好</div>
        </div>
        
        <div class="section">
            <div class="section-title">基本資訊</div>
            
            <div class="form-group">
                <label class="form-label" for="username">使用者名稱</label>
                <input type="text" id="username" class="form-input" value="林俊宇" placeholder="您的名稱">
                <div class="form-help">用於工時記錄的使用者識別</div>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="department">部門</label>
                <input type="text" id="department" class="form-input" value="資訊部" placeholder="部門名稱">
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">番茄鐘設定</div>
            
            <div class="form-group">
                <label class="form-label" for="interval">循環間隔</label>
                <select id="interval" class="form-select">
                    <option value="15">15 分鐘</option>
                    <option value="20">20 分鐘</option>
                    <option value="25" selected>25 分鐘（預設）</option>
                    <option value="30">30 分鐘</option>
                    <option value="45">45 分鐘</option>
                    <option value="60">60 分鐘</option>
                </select>
                <div class="form-help">番茄鐘跳窗的時間間隔</div>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="timeout">跳窗逾時</label>
                <select id="timeout" class="form-select">
                    <option value="3">3 分鐘</option>
                    <option value="5" selected>5 分鐘（預設）</option>
                    <option value="10">10 分鐘</option>
                    <option value="15">15 分鐘</option>
                </select>
                <div class="form-help">未回應跳窗多久後自動標記為待確認</div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">工作時段</div>
            
            <div class="form-group">
                <label class="form-label">工作時間</label>
                <div class="time-range">
                    <input type="time" id="work-start" class="form-input" value="08:00">
                    <span style="color: #a0aec0;">至</span>
                    <input type="time" id="work-end" class="form-input" value="17:30">
                </div>
                <div class="form-help">工作時段內才會跳窗提醒</div>
            </div>
            
            <div class="form-group">
                <label class="form-label">休息時段</label>
                <div class="time-range">
                    <input type="time" id="lunch-start" class="form-input" value="12:00">
                    <span style="color: #a0aec0;">至</span>
                    <input type="time" id="lunch-end" class="form-input" value="13:00">
                </div>
                <div class="form-help">休息時段不會跳窗</div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">系統設定</div>
            
            <div class="form-group">
                <label class="form-label" for="shortcut">全域快捷鍵</label>
                <input type="text" id="shortcut" class="form-input" value="Ctrl+Alt+T" readonly>
                <div class="form-help">隨時開啟任務記錄視窗（點擊輸入框後按下新組合鍵）</div>
            </div>
            
            <div class="form-group">
                <div class="form-check">
                    <input type="checkbox" id="autostart" class="form-checkbox" checked>
                    <label class="form-label" for="autostart" style="margin: 0;">開機自動啟動</label>
                </div>
                <div class="form-help">電腦開機時自動啟動工時記錄工具</div>
            </div>
            
            <div class="form-group">
                <div class="form-check">
                    <input type="checkbox" id="notifications" class="form-checkbox" checked>
                    <label class="form-label" for="notifications" style="margin: 0;">啟用系統通知</label>
                </div>
                <div class="form-help">番茄鐘到點時顯示系統通知</div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">同步設定</div>
            
            <div class="form-group">
                <label class="form-label" for="sync-url">同步伺服器</label>
                <input type="url" id="sync-url" class="form-input" 
                       value="https://mes.company.com/api/worktime" 
                       placeholder="https://...">
                <div class="form-help">Python API 端點位址（M5 功能）</div>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="sync-interval">同步頻率</label>
                <select id="sync-interval" class="form-select">
                    <option value="5" selected>每 5 分鐘</option>
                    <option value="10">每 10 分鐘</option>
                    <option value="15">每 15 分鐘</option>
                    <option value="30">每 30 分鐘</option>
                    <option value="manual">僅手動同步</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">同步狀態</label>
                <div>
                    <span class="badge">🔌 未連線</span>
                    <span class="badge">最後同步：從未</span>
                </div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">更新設定</div>
            
            <div class="form-group">
                <label class="form-label" for="update-url">更新伺服器</label>
                <input type="url" id="update-url" class="form-input" 
                       value="https://github.com/yourname/worktime-pomodoro/releases/latest/download" 
                       placeholder="https://...">
                <div class="form-help">應用程式更新檢查端點</div>
            </div>
            
            <div class="form-group">
                <div class="form-check">
                    <input type="checkbox" id="update-check" class="form-checkbox" checked>
                    <label class="form-label" for="update-check" style="margin: 0;">啟動時檢查更新</label>
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label">目前版本</label>
                <div>
                    <span class="badge success">v0.1.0</span>
                </div>
            </div>
        </div>
        
        <div class="actions">
            <button class="btn btn-primary" id="btn-save">💾 儲存設定</button>
            <button class="btn btn-secondary" id="btn-reset">🔄 重設為預設值</button>
        </div>
    </div>
    
    <script>
        // Save settings
        document.getElementById('btn-save').addEventListener('click', () => {
            const settings = {
                username: document.getElementById('username').value,
                department: document.getElementById('department').value,
                interval: parseInt(document.getElementById('interval').value),
                timeout: parseInt(document.getElementById('timeout').value),
                workStart: document.getElementById('work-start').value,
                workEnd: document.getElementById('work-end').value,
                lunchStart: document.getElementById('lunch-start').value,
                lunchEnd: document.getElementById('lunch-end').value,
                shortcut: document.getElementById('shortcut').value,
                autostart: document.getElementById('autostart').checked,
                notifications: document.getElementById('notifications').checked,
                syncUrl: document.getElementById('sync-url').value,
                syncInterval: document.getElementById('sync-interval').value,
                updateUrl: document.getElementById('update-url').value,
                updateCheck: document.getElementById('update-check').checked,
            };
            
            console.log('Save settings:', settings);
            // In real app: invoke('save_settings', settings)
            alert('設定已儲存！');
        });
        
        // Reset settings
        document.getElementById('btn-reset').addEventListener('click', () => {
            if (confirm('確定要重設所有設定為預設值嗎？')) {
                console.log('Reset settings');
                // In real app: invoke('reset_settings')
                location.reload();
            }
        });
        
        // Global shortcut recording
        document.getElementById('shortcut').addEventListener('keydown', (e) => {
            e.preventDefault();
            const keys = [];
            if (e.ctrlKey) keys.push('Ctrl');
            if (e.altKey) keys.push('Alt');
            if (e.shiftKey) keys.push('Shift');
            if (e.metaKey) keys.push('Meta');
            
            const key = e.key.toUpperCase();
            if (key !== 'CONTROL' && key !== 'ALT' && key !== 'SHIFT' && key !== 'META') {
                keys.push(key);
            }
            
            if (keys.length > 1) {
                e.target.value = keys.join('+');
            }
        });
    </script>
</body>
</html>
