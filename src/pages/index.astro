---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesktopLayout from '$components/DesktopLayout.svelte';
import TimerCard from '$components/TimerCard.svelte';
import TodayTimeline from '$components/TodayTimeline.svelte';
import QuickInputPalette from '$components/QuickInputPalette.svelte';
import InterruptDialog from '$components/InterruptDialog.svelte';
---

<BaseLayout title="番茄工時追蹤">
<DesktopLayout currentRoute="timer" client:load>
  <div class="flex h-screen gap-6 p-6">
    <!-- Left: Timer Card -->
    <div class="w-96">
      <TimerCard client:load />
    </div>
    
    <!-- Right: Today Timeline -->
    <div class="flex-1">
      <TodayTimeline client:load />
    </div>
  </div>
  
  <!-- Global Dialogs -->
  <QuickInputPalette client:only="svelte" />
  <InterruptDialog client:only="svelte" />
</DesktopLayout>
</BaseLayout>

<script>
  // Global keyboard shortcuts and tray events
  if (typeof window !== 'undefined') {
    import('@tauri-apps/plugin-global-shortcut').then(({ register }) => {
      // Register Ctrl+Alt+T for quick input
      register('Ctrl+Alt+T', () => {
        window.dispatchEvent(new CustomEvent('show-quick-input'));
      }).catch(err => console.error('Failed to register Ctrl+Alt+T:', err));
      
      // Register Ctrl+Alt+I for interrupt
      register('Ctrl+Alt+I', () => {
        window.dispatchEvent(new CustomEvent('show-interrupt'));
      }).catch(err => console.error('Failed to register Ctrl+Alt+I:', err));
    });

    // Listen to tray events
    import('@tauri-apps/api/event').then(({ listen }) => {
      listen('tray:quick_input', () => {
        window.dispatchEvent(new CustomEvent('show-quick-input'));
      });

      listen('tray:interrupt', () => {
        window.dispatchEvent(new CustomEvent('show-interrupt'));
      });

      listen('tray:pause_resume', () => {
        window.dispatchEvent(new CustomEvent('toggle-pause-resume'));
      });

      listen('tray:end_task', () => {
        window.dispatchEvent(new CustomEvent('end-task'));
      });
    });
  }
</script>
